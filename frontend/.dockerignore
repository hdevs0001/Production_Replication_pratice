# Ignore dependency directories (these should be installed inside the container instead)
node_modules/
venv/
.venv/

# Ignore source control records
.git
.gitignore

# Ignore local environment variables and secrets (CRITICAL for security)
.env
.env.local
*.pem
*.key

# Ignore local logs and debug dumps
*.log
npm-debug.log*
yarn-debug.log*

# Ignore OS-specific metadata files
.DS_Store
Thumbs.db

# Ignore build outputs or IDE configurations
dist/
build/
.idea/
.vscode/

# Ignore Docker files themselves (optional, prevents unexpected behavior)
Dockerfile
.dockerignore
